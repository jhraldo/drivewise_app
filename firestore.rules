rules_version = '2';

// ============================================================
// Reglas de seguridad de Firestore - DriveWise
// ============================================================
//
// Estructura de datos:
//   usuarios/{uid}                       perfil del usuario
//   usuarios/{uid}/vehiculos/{id}        vehículos registrados
//   usuarios/{uid}/gastos/{id}           gastos del vehículo
//   usuarios/{uid}/documentos/soat       datos del SOAT
//
// Regla general: cada usuario solo puede leer y escribir sus
// propios datos. Sin sesión iniciada no se puede acceder a nada.
// Cualquier ruta que no aparezca aquí queda bloqueada.
//
// Estas reglas se ejecutan en el servidor de Google, no en la app,
// por eso no se pueden saltar modificando el código del teléfono.
//
// Para publicarlas:
//   - Consola de Firebase > Firestore Database > Reglas, pegar y Publicar, o
//   - Terminal: firebase deploy --only firestore:rules --project drivewise-99cd6

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      // El perfil del usuario.
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Todas sus subcolecciones: vehiculos, gastos, documentos.
      match /{subcoleccion=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
